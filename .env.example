# Images versionnées utilisées par le projet (aucun secret ici)
SPARK_IMAGE=nyc-taxi-spark:3.5.3-python3.11
HADOOP_NAMENODE_IMAGE=bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
HADOOP_DATANODE_IMAGE=bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
KAFKA_IMAGE=apache/kafka:3.9.1

# Ressources fixes de chaque Spark Worker
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Facteur de réplication HDFS
HDFS_REPLICATION=2
